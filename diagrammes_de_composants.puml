@startuml
!theme plain
skinparam componentStyle uml2

title Diagramme de composants — architecture en couches et connecteurs (22/10/2026)

package "Frontend (client web)" {
    [Vues et composants\n(Vue 3, Tailwind, Chart.js)] as vue
    [Routeur (vue-router)\n+ gardes par rôle] as routeur
    [État global (Pinia)\nsession, thème] as stores
    [Client HTTP (axios)\njeton Sanctum, 401 => déconnexion] as http_client
    routeur --> vue : affiche la vue
    vue --> stores : lit / met à jour
    stores --> http_client : appels API
}

package "Systèmes externes (lecture seule)" {
    [API DSK\n(pointage RH)] as dsk_api
    database "Base EpiLogg\n(MySQL 8, prestataire CBC)\ncompte SQL lecture seule" as epilogg_db
}

package "Backend (API Laravel)" {
    interface "API REST\n(JSON, token Bearer)" as api_rest

    package "Couche API" {
        [Contrôleurs REST\n+ validation + policies] as controllers
    }

    package "Couche métier" {
        [StatistiquesService\n(consultation : lecture du cache,\nagrégations service / Total EPI)] as stats
        [ReferentielService\n(qualification compteurs DSK\net types de suivi)] as referentiel
        [EtlService\n(orchestrateur d'import)] as etl
        [ConsolidationService\n+ CalculEfficacite\n(cascade d'efficacité)] as conso
        [MatriceConversionService\n(historisation des barèmes)] as matrice
        interface "ConnecteurSource" as iconn
        [ConnecteurDsk\n(adaptateur HTTP)] as conn_dsk
        [ConnecteurEpilogg\n(adaptateur SQL)] as conn_epilogg
    }

    package "Couche persistance" {
        [ORM Eloquent\n(modèles, scopes)] as orm
    }

    [Planificateur\n(Laravel Scheduler)] as cron
    [File d'attente\n(jobs : import manuel,\nrecalcul) + worker] as queue

    api_rest - controllers

    controllers --> stats : consultation\n(périmètre validé par les policies)
    controllers --> matrice : changement de barème
    controllers --> referentiel : qualification
    controllers --> queue : import manuel, recalcul\n(réponse 202, suivi dans le journal)
    referentiel --> queue : recalcul des mois touchés
    queue --> etl : import manuel
    queue --> conso : recalcul
    cron --> etl : import quotidien

    etl --> iconn : demande les données
    iconn <|.. conn_dsk
    iconn <|.. conn_epilogg

    conn_dsk --> dsk_api : HTTPS (1×/jour)
    conn_epilogg --> epilogg_db : SQL via VPN (1×/jour)\nconnexion « epilogg », READ ONLY

    stats --> conso : même cascade\n(CalculEfficacite) sur les sommes
    stats --> orm : lecture du cache\nStatistiqueMensuelle uniquement
    etl --> orm : fenêtre remplacée\n(flux bruts, transaction)
    etl --> conso : consolidation des mois touchés
    conso --> orm : écriture du cache\n(seule source de calcul)
    matrice --> conso : recalcul depuis\nla date d'application
    matrice --> orm : clôture + création de règle\n(transaction)
}

database "Base locale" {
    [MariaDB 12.3\n(application)] as mariadb
    orm --> mariadb : SQL (TCP 3306)
}

http_client ..> api_rest : HTTPS

note bottom of iconn
  Pattern **Adaptateur** : l'EtlService ne dépend
  que de l'interface. Changer de mode d'accès
  (API, BDD, fichier) = changer un connecteur.
end note

@enduml
